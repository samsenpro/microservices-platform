# Copia este fichero a .env y cambia TODOS los valores. .env nunca se sube al repositorio.
# Genera secretos aleatorios, por ejemplo:  openssl rand -base64 48

# --- JWT: clave HMAC-SHA256 compartida por user-service (firma) y gateway/servicios (validación) -------
# Mínimo 32 bytes.
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes

# --- Config Server (basic auth) -------------------------------------------------------------------------
CONFIG_SERVER_USERNAME=config
CONFIG_SERVER_PASSWORD=change-me-config-password

# --- Eureka (basic auth; también protege el dashboard en http://localhost:8761) ------------------------
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=change-me-eureka-password

# --- Bases de datos: una por servicio, cada una con su propio usuario ---------------------------------
USERS_DB_USERNAME=users
USERS_DB_PASSWORD=change-me-users-db-password
PRODUCTS_DB_USERNAME=products
PRODUCTS_DB_PASSWORD=change-me-products-db-password
ORDERS_DB_USERNAME=orders
ORDERS_DB_PASSWORD=change-me-orders-db-password

# --- Administrador inicial (se crea solo si ADMIN_PASSWORD tiene valor; mínimo 12 caracteres) ---------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@platform.local
ADMIN_PASSWORD=change-me-admin-password

# --- Rate limiting del gateway (por IP en login/registro, por usuario en el resto) ---------------------
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_PERIOD=1m
RATE_LIMIT_API_REQUESTS=100
RATE_LIMIT_API_PERIOD=10s

# --- Puertos publicados en el host ------------------------------------------------------------------------
GATEWAY_PORT=8090
EUREKA_PORT=8761
USERS_DB_PORT=5441
PRODUCTS_DB_PORT=5442
ORDERS_DB_PORT=5443
